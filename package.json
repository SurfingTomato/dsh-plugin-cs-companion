{
  "name": "dsh-plugin-cs-companion",
  "version": "0.1.0",
  "description": "让你的大肥鱼能陪你看 CS 比赛 —— DeepSeek Harness 插件版",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cs2",
    "counter-strike",
    "esports",
    "5eplay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurfingTomato/dsh-plugin-cs-companion.git"
  },
  "homepage": "https://github.com/SurfingTomato/dsh-plugin-cs-companion#readme",
  "bugs": {
    "url": "https://github.com/SurfingTomato/dsh-plugin-cs-companion/issues"
  },
  "engines": {
    "dsh": ">=0.2.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0"
  }
}
